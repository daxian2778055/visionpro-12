# ===== 构建输出 =====
bin/
obj/

# ===== IDE / 用户配置 =====
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# ===== 运行时产物（随时可重新生成） =====
Log/
CrashDumps/

# ===== NuGet 包（可由 packages.config 还原，不入库） =====
packages/

# ===== 备份 / 临时 / 升级日志 =====
_refactor_backup/
_deleted_mes_db_backup/
backup/
*.bak
*.log
*.tmp
UpgradeLog*.htm

# ===== 崩溃诊断产物（含数百 MB 的转储，不入库） =====
error/
*.dmp

# ===== 工具元数据 / 分析产物（不入库） =====
.agnes/
_linecount.txt
代码审查报告*.html

# ===== 调试符号归档（随每次构建增长，不入库） =====
WindowsFormsApplication1/SymbolsArchive/

# ===== 编辑器/IDE 元数据 =====
.reasonix/

# ===== 安装包 / 发布产物（体积大，不应入库） =====
Setup1/Debug/
Setup1/Release/
Setup2/Debug/
Setup2/Release/
*.vdproj.release_version

# ===== 仓库根目录游离的旧 Form1.cs =====
# 历史重构快照，未纳入 csproj 编译（csproj 里 <Compile Include="Form1.cs"> 指的是
# WindowsFormsApplication1 子目录下真正参与编译的那份）。
# 前导 / 仅匹配仓库根目录这一个文件，避免误伤 WindowsFormsApplication1/Form1.cs。
/Form1.cs
